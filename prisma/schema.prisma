generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // NestJS builds to CommonJS and `nest build` emits require() calls. The
  // prisma-client generator is ESM-first, and the default output cannot be
  // imported from the compiled application at all.
  moduleFormat = "cjs"
  importFileExtension = ""
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // The connection string lives in prisma.config.ts. Prisma 7 moved it out of
  // the schema so the same schema can be pointed at different databases
  // without editing a checked-in file.
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  // uuid(7), not uuid(4). Version 7 is time-ordered, so inserts append to the
  // right-hand edge of the primary key index instead of scattering writes
  // across every page of it.
  id String @id @default(uuid(7)) @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.VarChar(2000)
  venue       String  @db.VarChar(200)

  // Timestamptz on every single one. Prisma maps DateTime to timestamp(3)
  // *without* a time zone by default, which for an API whose entire domain is
  // "when does this start" silently discards the offset.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  capacity        Int
  waitlistEnabled Boolean @default(true) @map("waitlist_enabled")

  registrationOpensAt  DateTime? @map("registration_opens_at") @db.Timestamptz(3)
  registrationClosesAt DateTime? @map("registration_closes_at") @db.Timestamptz(3)

  status EventStatus @default(DRAFT)

  registrations Registration[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // The listing endpoint's default query is "published events, soonest first".
  @@index([status, startsAt])
  @@map("events")
}

model Attendee {
  id String @id @default(uuid(7)) @db.Uuid

  // 320 = RFC 5321's 64-character local part, @, and a 255-character domain.
  email String @db.VarChar(320)
  name  String @db.VarChar(200)

  registrations Registration[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // No @unique on email. Uniqueness is case-insensitive and enforced by a
  // functional index on lower(email), which Prisma's schema language cannot
  // express — it is written by hand into the migration. A plain @unique here
  // would be strictly weaker and would let Ada@example.com and ada@example.com
  // both register as separate people.
  @@map("attendees")
}

model Registration {
  id String @id @default(uuid(7)) @db.Uuid

  eventId    String @map("event_id") @db.Uuid
  attendeeId String @map("attendee_id") @db.Uuid

  status RegistrationStatus @default(CONFIRMED)

  // Null unless status is WAITLISTED. Position 1 is next in line.
  waitlistPosition Int? @map("waitlist_position")

  registeredAt DateTime  @default(now()) @map("registered_at") @db.Timestamptz(3)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Deleting an event takes its registrations with it: they have no meaning
  // without one, and leaving them would strand rows pointing at nothing.
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Deleting an attendee who holds registrations *fails*. The API can then
  // answer 409 and name the reason, instead of silently gutting the roster of
  // every event that person had signed up for.
  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Restrict)

  // The hot path: counting confirmed registrations for one event.
  @@index([eventId, status])
  @@index([attendeeId])
  @@map("registrations")
}
