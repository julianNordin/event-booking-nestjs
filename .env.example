# Copy to .env and adjust. Every variable here is validated at boot; a missing
# or malformed one stops the process with a message naming it, rather than
# surfacing later as a 500 from whichever request first needed the value.

# development | test | production
NODE_ENV=development

PORT=3000

# Must agree with the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://events:events@localhost:5432/events

# Upper bound on the pg connection pool. Sized deliberately: the registration
# path holds an interactive transaction open across a row lock, and a pool
# smaller than the offered concurrency turns a capacity rejection into a pool
# timeout that looks identical from outside.
DATABASE_POOL_MAX=10

# Who may create and manage events, as name:key pairs.
# Required: the service refuses to start without knowing who is allowed to write.
API_KEYS=stockholm-tech:sk_dev_3f9a2b7c1e4d6a8b,malmo-events:sk_dev_9c2e5f1a7b3d8e04

# Rate limiting on the public write endpoints.
THROTTLE_LIMIT=10
THROTTLE_TTL_MS=60000
